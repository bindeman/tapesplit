# tapesplit configuration. Copy to .env (gitignored) and fill in only what you use.
# Every key is optional: without any of them tapesplit runs fully locally.
# `tapesplit doctor` shows which stages each setting unlocks.

# --- Gemini on Vertex AI: watches the video itself (the "understand" pass) ---
# Auth uses Application Default Credentials: gcloud auth application-default login
GEMINI_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_GCS_BUCKET=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MEDIA_RESOLUTION=low
GEMINI_DEFAULT_FPS=1
# Hard cap on cumulative Gemini spend for a project (USD). `tapesplit auto` also
# estimates each batch against --max-cloud-usd before it runs.
GEMINI_PROJECT_BUDGET_USD=10

# --- Local transcription with whisper.cpp ---
# Path to a ggml model, e.g. ggml-large-v3-turbo.bin from huggingface.co/ggerganov/whisper.cpp
WHISPER_CPP_MODEL=

# --- Speaker diarization with pyannote ---
# A Hugging Face token that has accepted pyannote/speaker-diarization-community-1's terms.
# Without it, diarization falls back to SpeechBrain.
HF_TOKEN=
HUGGINGFACE_TOKEN=

# --- Azure OpenAI: diarized transcription, verifier, frame descriptions, Journal ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REGION=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_REASONING_DEPLOYMENT=
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_FULL_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CODEX_DEPLOYMENT=
AZURE_OPENAI_WHISPER_DEPLOYMENT=
# Opt-ins for the Azure-backed stages:
# TAPESPLIT_DIARIZE_BACKEND=azure-openai
# TAPESPLIT_VERIFIER_BACKEND=azure

# --- Geocoding ---
# Google Maps is off unless enabled, and capped per day. Without it, tapesplit uses
# OpenStreetMap Nominatim; put a contact address in its User-Agent if you geocode a lot.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_DAILY_BUDGET_USD=0
TAPESPLIT_CONTACT_EMAIL=

# --- TwelveLabs: optional hosted video index (pip install -e '.[twelvelabs]') ---
TWELVELABS_API_KEY=

# --- Review UI ---
# The local review server only answers loopback hosts. List extra hostnames here
# only if you deliberately serve it on your LAN.
# TAPESPLIT_UI_ALLOWED_HOSTS=
